# ─── ParkVanta environment ────────────────────────────────────────────────
# Copy to .env and change every secret before deploying.
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (compose network host is `db`, local host uses port 55432)
POSTGRES_USER=parkvanta
POSTGRES_PASSWORD=parkvanta
POSTGRES_DB=parkvanta
DATABASE_URL=postgresql+psycopg://parkvanta:parkvanta@localhost:55432/parkvanta

# Redis: rate limiting and ephemeral state only. Never the source of truth.
REDIS_URL=redis://localhost:56379/0

# Generate with: openssl rand -hex 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-before-deploying
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Public web origin used in transactional links (password reset)
APP_PUBLIC_URL=http://localhost:5173

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated Host header allowlist. `*` accepts any host; set real hosts in production.
ALLOWED_HOSTS=*

# Gate policy defaults
DEFAULT_QR_VALIDITY_MINUTES=240
DEFAULT_OVERSTAY_GRACE_MINUTES=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# Durable SSE replay archive retention (days)
EVENT_RETENTION_DAYS=30

# Operational metrics and worker health. Set METRICS_TOKEN unless /metrics is private.
METRICS_TOKEN=
OUTBOX_STALE_MINUTES=10
WORKER_STALE_MINUTES=5

# Transactional email. Leave SMTP_HOST empty in development to log reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ParkVanta <no-reply@parkvanta.local>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Demo seed password (development only)
SEED_PASSWORD=ParkVanta@2026
