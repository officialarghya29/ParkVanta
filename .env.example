# ─── ParkVanta environment ────────────────────────────────────────────────
# Copy to .env and change every secret before deploying.
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (compose network host is `db`, local host uses port 55432)
POSTGRES_USER=parkvanta
POSTGRES_PASSWORD=parkvanta
POSTGRES_DB=parkvanta
DATABASE_URL=postgresql+psycopg://parkvanta:parkvanta@localhost:55432/parkvanta

# Redis: rate limiting and ephemeral state only. Never the source of truth.
REDIS_URL=redis://localhost:56379/0

# Generate with: openssl rand -hex 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-before-deploying
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gate policy defaults
DEFAULT_QR_VALIDITY_MINUTES=240
DEFAULT_OVERSTAY_GRACE_MINUTES=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# Demo seed password (development only)
SEED_PASSWORD=ParkVanta@2026

# Optional AI vision service (Stage 13). The product works without it.
VISION_ENABLED=false
VISION_SERVICE_URL=
