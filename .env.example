# ─── ParkVanta environment ────────────────────────────────────────────────
# Copy to .env and change every secret before deploying.
ENVIRONMENT=development
DEBUG=false
# Leave blank to enable /docs and /redoc only outside production, or set true/false explicitly.
ENABLE_API_DOCS=

# PostgreSQL (compose network host is `db`, local host uses port 55432;
# postgres:// and postgresql:// URLs are normalized to postgresql+psycopg://)
POSTGRES_USER=parkvanta
POSTGRES_PASSWORD=parkvanta
POSTGRES_DB=parkvanta
DATABASE_URL=postgresql+psycopg://parkvanta:parkvanta@localhost:55432/parkvanta

# Redis: rate limiting and ephemeral state only. Never the source of truth.
REDIS_URL=redis://localhost:56379/0

# Generate with: openssl rand -hex 48 (minimum 32 chars in production)
JWT_SECRET=dev-only-insecure-jwt-secret-change-before-deploying
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Refresh cookie SameSite mode: `lax` (same-site/reverse-proxy) or `none` (separate Railway subdomains / cross-site HTTPS)
REFRESH_COOKIE_SAMESITE=lax

# Public web origin used in transactional links (password reset)
APP_PUBLIC_URL=http://localhost:5173

# Browser origins allowed to call the API (comma separated; https:// required in production, never `*`)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated Host header allowlist (no `*` in production; e.g. api.example.com or *.up.railway.app)
ALLOWED_HOSTS=*
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For. Empty means ignore it.
TRUSTED_PROXIES=

# Frontend build/runtime API base URL (used by apps/web Vite build and Nginx entrypoint)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Gate policy defaults
DEFAULT_QR_VALIDITY_MINUTES=240
DEFAULT_OVERSTAY_GRACE_MINUTES=30
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# Durable SSE replay archive retention (days)
EVENT_RETENTION_DAYS=30

# Operational metrics and worker health. METRICS_TOKEN (>=16 chars) is required in production.
METRICS_TOKEN=
OUTBOX_STALE_MINUTES=10
WORKER_STALE_MINUTES=5

# Transactional email. Leave SMTP_HOST empty in development to log reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ParkVanta <no-reply@parkvanta.local>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Demo seed password (development only)
SEED_PASSWORD=ParkVanta@2026
